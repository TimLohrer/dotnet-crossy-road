# Copy to .env and fill in. .env is gitignored.

DOCKERHUB_USERNAME=yourdockerhubuser

# Database
DB_USER=crossy-road
DB_PASSWORD=change-me
DB_NAME=crossy-road

# Bosch OAuth
BOSCH_CLIENT_ID=
BOSCH_CLIENT_SECRET=
BOSCH_TENANT_ID=
BOSCH_METADATA_ADDRESS=
BOSCH_SCOPES=profile,openid,email

# Microsoft OAuth
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_METADATA_ADDRESS=
MS_SCOPES=profile,openid

# Frontend
PUBLIC_API_URL=https://your-domain.example.com/api/v1
